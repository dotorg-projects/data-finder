<Project Sdk="MSTest.Sdk/4.0.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DotOrgProjects.EntityPlatform.Finder.Tests</AssemblyName>
    <AssemblyTitle>EP Finder Tests</AssemblyTitle>
    <Copyright>.ORG Projects</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageTags>EP;.ORG Projects;EP Finder;Tests;.NET;EF Core</PackageTags>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <OutputType>Exe</OutputType>
    <EnableMicrosoftTestingExtensionsCodeCoverage>true</EnableMicrosoftTestingExtensionsCodeCoverage>
    <Contributors>
      <Contributor>
        <Alias>rrangelo</Alias>
        <Name>Ramon Rangel Osorio</Name>
        <Email>ramon.rangel@protonmail.com</Email>
        <Url>https://github.com/rrangelo</Url>
        <Role>Developer</Role>
      </Contributor>
    </Contributors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EP Finder\EP Finder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="MSTest.runsettings">
      <Generator>SettingsSingleFileGenerator</Generator>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.19" />
  </ItemGroup>

</Project>